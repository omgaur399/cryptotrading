}

.watchlist-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    cursor: pointer;
    border-bottom: 1px solid hsla(220,15%,22%,0.5);
    transition: background 120ms var(--ease);
    gap: 6px;
}

.watchlist-row:hover {
    background: hsla(215, 80%, 55%, 0.08);
}

.watchlist-row:last-child { border-bottom: none; }

.watchlist-row.active-wl {
    background: hsla(215, 80%, 55%, 0.13);
}

.wl-left {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
}

.wl-symbol {
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.wl-name {
    font-size: 9.5px;
    color: var(--subtle);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 1px;
}

.wl-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 2px;
}

.wl-price {
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
    transition: color 250ms var(--ease);
}

.wl-change {
    font-size: 10px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
}

.wl-change.up  { color: var(--green); }
.wl-change.down { color: var(--red); }

/* Watchlist row flash */
.wl-price.flash-up   { animation: flashUp   300ms var(--ease-out); }
.wl-price.flash-down { animation: flashDown 300ms var(--ease-out); }

/* ── Right-Click Context Menu ───────────────────────── */
.ctx-menu {
    position: fixed;
    z-index: 9000;
    min-width: 190px;
    background: var(--glass-bg);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    box-shadow: var(--glass-shadow), 0 0 0 1px hsla(220,30%,40%,0.08) inset;
    padding: 5px;
    display: none;
    flex-direction: column;
    gap: 1px;
    opacity: 0;
    transform: scale(0.95) translateY(-4px);
    transform-origin: top left;
    transition: opacity 130ms var(--ease-out), transform 130ms var(--ease-out);
    pointer-events: none;
}

.ctx-menu.visible {
    display: flex;
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
}

.ctx-menu-header {
    padding: 6px 10px 4px;
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3px;
    font-variant-numeric: tabular-nums;
}

.ctx-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 7px 10px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text);
    font-size: 12px;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: background 120ms var(--ease), color 120ms var(--ease), transform 80ms var(--ease-out);
    white-space: nowrap;
}

.ctx-item svg {
    flex-shrink: 0;
    color: var(--muted);
    transition: color 120ms var(--ease);
}

.ctx-item:hover {
    background: hsla(215, 80%, 55%, 0.14);
    color: var(--text);
}

.ctx-item:hover svg { color: var(--blue); }
.ctx-item:active { transform: scale(0.98); }

.ctx-separator {
    height: 1px;
    background: var(--border);
    margin: 3px 4px;
}

/* Light theme overrides for new features */
body.light-theme .watchlist-panel {
    background: #ffffff;
    border-left-color: #cbd5e1;
    box-shadow: -4px 0 24px rgba(0,0,0,0.12);
}

body.light-theme .watchlist-header {
    background: #f8fafc;
    border-bottom-color: #cbd5e1;
}

body.light-theme .watchlist-title { color: #0f172a; }
body.light-theme .wl-symbol { color: #0f172a; }
body.light-theme .wl-name { color: #94a3b8; }

body.light-theme .watchlist-row {
    border-bottom-color: #f1f5f9;
}
body.light-theme .watchlist-row:hover {
    background: rgba(59,130,246,0.06);
}

body.light-theme .ctx-menu {
    background: rgba(255,255,255,0.95);
    border-color: #e2e8f0;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
}
body.light-theme .ctx-menu-header { color: #64748b; border-bottom-color: #e2e8f0; }
body.light-theme .ctx-item { color: #0f172a; }
body.light-theme .ctx-item:hover { background: #eff6ff; }
body.light-theme .ctx-separator { background: #e2e8f0; }


body.light-theme .header-icon-btn { color: #64748b; }
body.light-theme .header-icon-btn:hover { background: #f1f5f9; border-color: #cbd5e1; color: #0f172a; }
body.light-theme .header-icon-btn.active { color: #2563eb; background: #eff6ff; border-color: #bfdbfe; }

/* ── Keyframe Animations ────────────────────────────── */
@keyframes flashUp {
    0%   { color: var(--green); }
    100% { color: var(--text);  }
}

@keyframes flashDown {
    0%   { color: var(--red); }
    100% { color: var(--text); }
}

@keyframes badgePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.7; transform: scale(1.1); }
}

/* ── Global Right Sidebar ───────────────────────────── */
.global-right-sidebar {
    width: 300px;
    height: 100%;
    flex-shrink: 0;
    transition: width 240ms cubic-bezier(0.4, 0, 0.2, 1), opacity 240ms;
    overflow: hidden;
    background: var(--panel);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    opacity: 1;
}

.global-right-sidebar.collapsed {
    width: 0px !important;
    border-left: none !important;
    opacity: 0;
    pointer-events: none;
}

.global-right-sidebar .right-sidebar-wrapper {
    width: 300px;
    height: 100%;
    border: none;
    border-radius: 0;
}
