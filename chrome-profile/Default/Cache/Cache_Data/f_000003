/* ============================================================
   PREMIUM DARK THEME — Crypto Trading Dashboard
   HSL-tailored palette + glassmorphism + micro-animations
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

/* ── Design Tokens ──────────────────────────────────────── */
:root {
    /* Base surfaces */
    --bg:       hsl(220, 14%, 6%);
    --panel:    hsl(220, 16%, 10%);
    --panel-2:  hsl(220, 18%, 13%);
    --panel-3:  hsl(220, 20%, 16%);

    /* Borders */
    --border:       hsl(220, 15%, 22%);
    --border-light: hsl(220, 15%, 28%);

    /* Text */
    --text:   hsl(213, 27%, 92%);
    --muted:  hsl(213, 10%, 60%);
    --subtle: hsl(213, 10%, 40%);

    /* Accent colours */
    --green:      hsl(145, 72%, 42%);
    --green-glow: hsla(145, 72%, 42%, 0.35);
    --red:        hsl(0,   72%, 51%);
    --red-glow:   hsla(0,   72%, 51%, 0.35);
    --amber:      hsl(38,  92%, 50%);
    --blue:       hsl(215, 90%, 60%);
    --blue-glow:  hsla(215, 90%, 60%, 0.3);

    /* Glassmorphism */
    --glass-bg:      hsla(220, 20%, 14%, 0.82);
    --glass-border:  hsla(220, 30%, 40%, 0.25);
    --glass-shadow:  0 8px 32px hsla(0, 0%, 0%, 0.45), 0 1px 0 hsla(255,255%,255%,0.04) inset;

    /* Elevation shadows */
    --shadow-sm: 0 1px 3px hsla(0,0%,0%,0.5), 0 1px 2px hsla(0,0%,0%,0.4);
    --shadow-md: 0 4px 16px hsla(0,0%,0%,0.55), 0 1px 4px hsla(0,0%,0%,0.4);
    --shadow-lg: 0 8px 32px hsla(0,0%,0%,0.6),  0 2px 8px  hsla(0,0%,0%,0.45);

    /* Transitions */
    --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --ease-out: cubic-bezier(0.0, 0.0, 0.2, 1);

    /* Active chart highlight */
    --active-accent: hsl(215, 90%, 60%);
}

/* ── Reset ──────────────────────────────────────────────── */
* { box-sizing: border-box; }

html, body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    /* Subtle radial gradient adds depth to the dark bg */
    background: radial-gradient(ellipse 130% 80% at 50% 0%, hsl(220,22%,9%) 0%, var(--bg) 70%);
    color: var(--text);
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
}

body {
    display: grid;
    grid-template-rows: auto 1fr auto;
}

/* ── Header & Status Bar ────────────────────────────────── */
.dashboard-header,
.status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--panel);
    border-color: var(--border);
}

.dashboard-header {
    height: 48px;
    padding: 0 14px;
    box-sizing: border-box;
    border-bottom: 1px solid var(--border);
    /* Glassy top edge shimmer */
    box-shadow: 0 1px 0 var(--border), 0 2px 12px hsla(0,0%,0%,0.4);
}

.status-bar {
    height: 22px;
    padding: 0 14px;
    box-sizing: border-box;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.01em;
}

/* ── Brand ──────────────────────────────────────────────── */
.brand-block {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex-shrink: 0;
}

h1 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.3px;
    white-space: nowrap;
    /* Subtle brand gradient */
    background: linear-gradient(135deg, var(--text) 0%, hsl(213,30%,75%) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* ── Connection indicator — breathing pulse ─────────────── */
.status-indicator {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 400ms var(--ease);
}

/* Dot before the text */
.status-indicator::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
}

.status-indicator.connected {
    color: var(--green);
}
.status-indicator.connected::before {
    animation: breatheGreen 2s ease-in-out infinite;
    box-shadow: 0 0 0 0 var(--green-glow);
}

.status-indicator.disconnected {
    color: var(--red);
}
.status-indicator.disconnected::before {
    animation: breatheRed 2s ease-in-out infinite;
    box-shadow: 0 0 0 0 var(--red-glow);
}

@keyframes breatheGreen {
    0%   { box-shadow: 0 0 0 0   var(--green-glow); transform: scale(1);    }
    50%  { box-shadow: 0 0 0 6px hsla(145,72%,42%,0); transform: scale(1.15); }
    100% { box-shadow: 0 0 0 0   var(--green-glow); transform: scale(1);    }
}
@keyframes breatheRed {
    0%   { box-shadow: 0 0 0 0   var(--red-glow); transform: scale(1);    }
    50%  { box-shadow: 0 0 0 6px hsla(0,72%,51%,0); transform: scale(1.15); }
    100% { box-shadow: 0 0 0 0   var(--red-glow); transform: scale(1);    }
}

/* ── Top Controls ───────────────────────────────────────── */
.top-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
}

label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
}

/* ── Select elements (global) ───────────────────────────── */
select {
    min-width: 76px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--panel-3);
    color: var(--text);
    font-size: 12px;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 200ms var(--ease), box-shadow 200ms var(--ease);
    padding: 0 6px;
}
select:hover  { border-color: var(--border-light); }
select:focus  {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px var(--blue-glow);
}

/* ── Charts Grid ────────────────────────────────────────── */
.dashboard-main {
    height: calc(100vh - 70px);
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: row;
    width: 100%;
}

.dashboard-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    height: 100%;
}

.main-charts-wrapper {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    width: 100%;
}

.charts-grid {
    display: grid;
    width: 100%;
    flex: 1;
    min-height: 0;
    gap: 10px;
    padding: 10px;
    background: transparent;
    overflow-y: auto;
}

.layout-1 {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(280px, 1fr);
}
.layout-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: minmax(280px, 1fr);
}
.layout-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(280px, 1fr));
}
.layout-6 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(280px, 1fr));
}
.layout-8 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(280px, 1fr));
}

/* ── Chart Pane — Floating card ─────────────────────────── */
.chart-pane {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Layered border + shadow for depth */
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--panel);
    box-shadow: var(--shadow-md);
    transition: border-color 220ms var(--ease), box-shadow 220ms var(--ease), transform 150ms var(--ease);
    will-change: transform, box-shadow;
}

.chart-pane:hover {
    border-color: var(--border-light);
    box-shadow: var(--shadow-lg);
}

/* Active chart — glowing blue ring */
.chart-pane.active-chart {
    border-color: hsl(215, 80%, 50%);
    box-shadow: 0 0 0 1px hsl(215, 80%, 50%), var(--shadow-lg), 0 0 20px hsla(215, 90%, 55%, 0.12);
}

/* ── Pane Header ────────────────────────────────────────── */
.pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 4px;
    height: 32px;
    padding: 0 8px;
    background: linear-gradient(180deg, var(--panel-3) 0%, var(--panel-2) 100%);
    border-bottom: 1px solid var(--border);
    transition: background 180ms var(--ease);
    flex-shrink: 0;
    overflow: hidden;
}

.pane-ticker {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
}

.pane-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    flex-shrink: 0;
    flex-wrap: nowrap;
}

/* ── Ticker text ────────────────────────────────────────── */
.ticker-symbol {
    min-width: 45px;
    font-size: 11px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.01em;
}

.ticker-price {
    min-width: 50px;
    font-size: 11px;
    text-align: right;
    font-variant-numeric: tabular-nums;
    transition: color 250ms var(--ease);
}

.ticker-change {
    min-width: 40px;
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    transition: color 250ms var(--ease);
}

.up   { color: var(--green); }
.down { color: var(--red);   }

/* ── Pane selects ───────────────────────────────────────── */
.pane-select {
    min-width: 0;
    height: 22px;
    font-size: 11px;
    padding: 0 4px;
    margin: 0;
    border-radius: 5px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: hsla(220, 18%, 10%, 0.85);
    color: var(--text);
    font-family: inherit;
    transition: border-color 180ms var(--ease), background 180ms var(--ease), box-shadow 180ms var(--ease);
}
.pane-select:hover { border-color: var(--border-light); }
.pane-select:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 2px var(--blue-glow);
}

.chart-type-select  { width: 65px; }
.interval-select    { width: 48px; }

.indicator-select {
    width: 34px;
    padding: 0;
    text-align: center;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
}

/* ── Symbol search input ────────────────────────────────── */
.symbol-select-container {
    position: relative;
    width: 65px;
    min-width: 0;
    height: 22px;
}

.symbol-select-input {
    width: 100%;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: hsla(220, 18%, 8%, 0.9);
    color: var(--text);
    font-size: 11px;
    font-family: inherit;
    padding: 0 4px;
    margin: 0;
    display: block;
    box-sizing: border-box;
    transition: border-color 180ms var(--ease), box-shadow 180ms var(--ease), background 180ms var(--ease);
}

.symbol-select-input:hover { border-color: var(--border-light); }

.symbol-select-input:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 2px var(--blue-glow), 0 0 8px hsla(215, 90%, 60%, 0.15);
    background: hsla(220, 22%, 11%, 0.95);
}

/* ── Glassmorphic dropdown ──────────────────────────────── */
.custom-select-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 3px);
    left: 0;
    right: 0;
    /* Glassmorphism */
    background: var(--glass-bg);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    max-height: 220px;
    overflow-y: auto;
    z-index: 200;
    box-shadow: var(--glass-shadow);
    /* Entrance animation */
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    transition: opacity 150ms var(--ease-out), transform 150ms var(--ease-out);
}

.custom-select-dropdown.show {
    display: block;
    opacity: 1;
    transform: translateY(0) scale(1);
}

/* Thin scrollbar */
.custom-select-dropdown::-webkit-scrollbar { width: 4px; }
.custom-select-dropdown::-webkit-scrollbar-track { background: transparent; }
.custom-select-dropdown::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

.custom-select-option {
    padding: 5px 8px;
    cursor: pointer;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--muted);
    transition: background 120ms var(--ease), color 120ms var(--ease);
}

.custom-select-option:hover,
.custom-select-option.highlighted {
    background: hsla(215, 80%, 55%, 0.15);
    color: var(--text);
}

/* ── Settings / icon buttons ────────────────────────────── */
.settings-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 4px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 150ms var(--ease), background 150ms var(--ease),
                border-color 150ms var(--ease), transform 120ms var(--ease-out);
}
.settings-btn:hover {
    color: var(--text);
    background: hsla(220, 20%, 30%, 0.4);
    border-color: var(--border-light);
    transform: scale(1.1);
}
.settings-btn:active { transform: scale(0.95); }

/* ── Compact layouts ────────────────────────────────────── */
.layout-4 .pane-header { height: 30px; padding: 0 6px; }

.layout-6 .pane-header,
.layout-8 .pane-header { height: 26px; padding: 0 4px; gap: 2px; }

.layout-6 .pane-ticker,
.layout-8 .pane-ticker { gap: 4px; }

.layout-6 .pane-controls,
.layout-8 .pane-controls { gap: 3px; }

.layout-6 .ticker-symbol, .layout-8 .ticker-symbol,
.layout-6 .ticker-price,  .layout-8 .ticker-price,
.layout-6 .ticker-change, .layout-8 .ticker-change { font-size: 10px; }

.layout-6 .symbol-select-container,
.layout-8 .symbol-select-container { width: 55px; height: 18px; }

.layout-6 .chart-type-select, .layout-8 .chart-type-select { width: 48px; }
.layout-6 .interval-select,   .layout-8 .interval-select   { width: 42px; }
.layout-6 .indicator-select,  .layout-8 .indicator-select  { width: 28px; }

.layout-6 .pane-select, .layout-8 .pane-select { height: 18px; font-size: 10px; }

.layout-6 .symbol-select-input,
.layout-8 .symbol-select-input { height: 18px; font-size: 10px; padding: 0 2px; }

.layout-6 .settings-btn, .layout-8 .settings-btn { padding: 2px; margin-left: 0; }
.layout-6 .settings-btn svg, .layout-8 .settings-btn svg { width: 13px; height: 13px; }

/* ── Chart Container ────────────────────────────────────── */
.chart-container {
    position: relative;
    flex: 1;
    min-height: 0;
    width: 100%;
}

/* Force charting elements to strictly respect container bounds */
.chart-container > div:not(.chart-message):not(.countdown-timer),
.chart-container > svg {
    position: absolute !important;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100% !important;
    height: 100% !important;
}

/* ── Countdown timer ────────────────────────────────────── */
.countdown-timer {
    position: absolute;
    right: 0;
    padding: 0;
    height: 32px;
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-size: 10px;
    font-weight: bold;
    color: #ffffff;
    pointer-events: none;
    z-index: 10;
    border-radius: 0 0 0 4px;
}
.countdown-timer.up   { background-color: var(--green); }
.countdown-timer.down { background-color: var(--red);   }
.countdown-timer.show { display: flex; }
.countdown-timer .timer-val {
    font-size: 8px;
    font-weight: normal;
    opacity: 0.85;
    margin-top: 1px;
}

/* ── Chart message overlay ──────────────────────────────── */
.chart-message {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    padding: 18px;
    color: var(--muted);
    text-align: center;
    /* Subtle frosted overlay */
    background: hsla(220, 14%, 6%, 0.65);
    backdrop-filter: blur(4px);
    font-size: 13px;
    border-radius: 0 0 10px 10px;
}

/* ── Ticker flash animations ─────────────────────────────── */
.flash-up   { animation: flashUp   400ms var(--ease-out); }
.flash-down { animation: flashDown 400ms var(--ease-out); }

@keyframes flashUp {
    0%   { background: hsla(145, 72%, 42%, 0.38); }
    100% { background: transparent; }
}
@keyframes flashDown {
    0%   { background: hsla(0, 72%, 51%, 0.38); }
    100% { background: transparent; }
}

/* ── Scrollbar (global) ─────────────────────────────────── */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--border-light); }

/* ── Responsive ─────────────────────────────────────────── */
@media (max-width: 980px) {
    .layout-6 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: repeat(3, minmax(280px, 1fr));
    }
    .layout-8 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: repeat(4, minmax(280px, 1fr));
    }
}

@media (max-width: 700px) {
    body { overflow: auto; }
    .dashboard-header { align-items: stretch; flex-direction: column; }
    .dashboard-main   { height: auto; }
    .charts-grid, .layout-1, .layout-2, .layout-4, .layout-6, .layout-8 {
        grid-template-columns: 1fr;
        grid-auto-rows: minmax(340px, 60vh);
        height: auto;
    }
}

/* ── Tabbed Indicator Settings Modal ─────────────────────── */
.sp-modal {
    width: 340px !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: flex;
    flex-direction: column;
}

.sp-header {
    padding: 16px 20px 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--panel-3);
}

.sp-tabs {
    display: flex;
    background: var(--panel-2);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
}

.sp-tab {
    flex: 1;
    padding: 9px 0;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 150ms var(--ease), border-color 150ms var(--ease), background 150ms var(--ease);
    letter-spacing: 0.03em;
    text-transform: uppercase;
}
.sp-tab:hover { color: var(--text); background: hsla(215,80%,55%,0.08); }
.sp-tab.active {
    color: var(--blue);
    border-bottom-color: var(--blue);
    background: hsla(215,80%,55%,0.1);
}

.sp-panel {
    display: none;
    padding: 16px 20px;
    flex-direction: column;
    gap: 0;
    flex: 1;
    overflow-y: auto;
}
.sp-panel.active { display: flex; }

.sp-input {
    width: 90px !important;
    background: var(--panel-3) !important;
    border: 1px solid var(--border) !important;
    border-radius: 5px !important;
    color: var(--text) !important;
    font-family: inherit !important;
    font-size: 12px !important;
    padding: 4px 6px !important;
    transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease);
}
.sp-input:focus {
    outline: none !important;
    border-color: var(--blue) !important;
    box-shadow: 0 0 0 2px var(--blue-glow) !important;
}

.sp-select {
    width: 90px !important;
    height: 26px !important;
    font-size: 12px !important;
}

.sp-color-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
}
.sp-color-wrap input[type="color"] {
    width: 32px;
    height: 26px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: transparent;
    cursor: pointer;
}
.sp-color-hex {
    font-size: 11px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    font-family: monospace;
}

.sp-reset-btn {
    margin-top: 14px;
    align-self: flex-start;
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: transparent;
    color: var(--muted);
    font-size: 11px;
    font-family: inherit;
    cursor: pointer;
    transition: color 150ms var(--ease), border-color 150ms var(--ease), background 150ms var(--ease);
}
.sp-reset-btn:hover {
    color: var(--text);
    border-color: var(--border-light);
    background: hsla(220,18%,24%,0.5);
}

/* Override settings-actions to fit the new modal */
.sp-modal .settings-actions {
    padding: 12px 20px 16px;
    border-top: 1px solid var(--border);
    background: var(--panel-2);
    margin-top: 0 !important;
    flex-shrink: 0;
}
.sp-modal .settings-actions button {
    padding: 7px 18px;
    border-radius: 6px;
    border: none;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 150ms var(--ease), transform 100ms var(--ease);
}
.sp-modal .settings-actions button:hover  { opacity: 0.88; }
.sp-modal .settings-actions button:active { transform: scale(0.97); }

/* ── Grid Resize Handles ─────────────────────────────────── */
.grid-resize-handle {
    position: absolute;
    z-index: 50;
    /* Invisible by default, active zone on hover */
    background: transparent;
    transition: background 150ms var(--ease);
}

.grid-resize-v {
    cursor: col-resize;
    width: 10px;
    top: 0;
    height: 100%;
}
.grid-resize-v:hover,
.grid-resize-v.dragging {
    background: linear-gradient(to right,
        transparent 0%, hsla(215,80%,55%,0.3) 40%,
        hsla(215,80%,55%,0.3) 60%, transparent 100%);
}

.grid-resize-h {
    cursor: row-resize;
    height: 10px;
    left: 0;
    width: 100%;
}
.grid-resize-h:hover,
.grid-resize-h.dragging {
    background: linear-gradient(to bottom,
        transparent 0%, hsla(215,80%,55%,0.3) 40%,
        hsla(215,80%,55%,0.3) 60%, transparent 100%);
}

/* Prevent text selection while dragging */
body:has(.grid-resize-handle.dragging) {
    user-select: none;
    cursor: col-resize;
}
body:has(.grid-resize-h.dragging) {
    cursor: row-resize;
}

/* ── Drawing Toolbar (Left Sidebar) ───────────────────────── */
.drawing-toolbar {
    width: 36px;
    flex-shrink: 0;
    background: var(--panel-2);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
    gap: 8px;
    flex-shrink: 0;
    z-index: 90;
    box-shadow: 2px 0 12px hsla(0,0%,0%,0.2);
}

body.light-theme .drawing-toolbar {
    background: #ffffff;
    border-right-color: #cbd5e1;
    box-shadow: 2px 0 12px rgba(0,0,0,0.05);
}

.toolbar-btn {
    width: 26px;
    height: 26px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 180ms var(--ease);
}

.toolbar-btn:hover {
    color: var(--text);
    background: hsla(220, 20%, 30%, 0.4);
    border-color: var(--border-light);
    transform: scale(1.08);
}

body.light-theme .toolbar-btn:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
}

.toolbar-btn:active {
    transform: scale(0.95);
}

.toolbar-btn.active {
    color: var(--blue);
    background: hsla(215, 90%, 60%, 0.15);
    border-color: hsla(215, 90%, 60%, 0.35);
}

body.light-theme .toolbar-btn.active {
    color: #2563eb;
    background: #eff6ff;
    border-color: #bfdbfe;
}

.toolbar-separator {
    width: 16px;
    height: 1px;
    background: var(--border);
    margin: 4px 0;
}

body.light-theme .toolbar-separator {
    background: #cbd5e1;
}

/* ── Toolbar dropdown group ─────────────────────────────── */
.toolbar-group {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
}

.toolbar-group-btn-row {
    display: flex;
    align-items: center;
    gap: 1px;
}

.toolbar-group-arrow {
    width: 10px;
    height: 16px;
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 3px;
    transition: color 180ms var(--ease), background 180ms var(--ease);
}
.toolbar-group-arrow:hover {
    color: var(--text);
    background: hsla(220, 20%, 30%, 0.4);
}
body.light-theme .toolbar-group-arrow:hover {
    background: #f1f5f9;
}

.toolbar-dropdown {
    position: absolute;
    left: 40px;
    top: 0;
    background: var(--panel-2);
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 4px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 500;
    min-width: 175px;
    box-shadow: 4px 4px 20px rgba(0,0,0,0.4);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-6px);
    transition: opacity 150ms var(--ease), transform 150ms var(--ease);
}
body.light-theme .toolbar-dropdown {
    background: #fff;
    border-color: #cbd5e1;
    box-shadow: 4px 4px 20px rgba(0,0,0,0.12);
}

.toolbar-dropdown.open {
    opacity: 1;
    pointer-events: all;
    transform: translateX(0);
}

.toolbar-dropdown-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 10px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 12px;
    color: var(--text-secondary);
    transition: background 150ms, color 150ms;
    white-space: nowrap;
    user-select: none;
}
.toolbar-dropdown-item:hover {
    background: hsla(220, 20%, 30%, 0.4);
    color: var(--text);
}
body.light-theme .toolbar-dropdown-item:hover {
    background: #f1f5f9;
    color: #0f172a;
}
.toolbar-dropdown-item svg {
    flex-shrink: 0;
    color: var(--muted);
}
.toolbar-dropdown-item:hover svg {
    color: var(--text);
}
.toolbar-dropdown-item.active-tool svg {
    color: var(--blue);
}
.toolbar-dropdown-item.active-tool {
    color: var(--blue);
}

.trash-btn {
    color: hsl(0, 70%, 60%);
}

.trash-btn:hover {
    color: #ffffff;
    background: hsl(0, 70%, 50%);
    border-color: hsl(0, 70%, 40%);
}

body.light-theme .trash-btn:hover {
    color: #ffffff;
    background: #ef4444;
    border-color: #dc2626;
}

/* ── Chart Legend Overlay ─────────────────────────────────── */
.chart-legend {
    position: absolute;
    top: 6px;
    left: 10px;
    z-index: 40;
    pointer-events: none;
    font-family: inherit;
    user-select: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
    max-width: calc(100% - 70px);
}

.legend-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    line-height: 1.4;
}

.main-ohlc {
    font-size: 12px;
    font-weight: 500;
}

.legend-symbol-name {
    font-weight: 700;
    color: var(--text);
    margin-right: 2px;
}

.legend-interval {
    color: var(--muted);
    font-size: 11px;
    margin-right: 6px;
}

.legend-ohlc-label {
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
}

.legend-ohlc-val {
    font-family: monospace;
    font-size: 11px;
    margin-right: 6px;
}

.legend-up {
    color: var(--green) !important;
}

.legend-down {
    color: var(--red) !important;
}

.indicators-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
}

.legend-ind-row {
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: auto;
    background: transparent;
    padding: 1px 4px;
    border-radius: 4px;
    transition: background 150ms var(--ease);
}

.legend-ind-row:hover {
    background: hsla(220, 20%, 30%, 0.25);
}

body.light-theme .legend-ind-row:hover {
    background: rgba(0, 0, 0, 0.05);
}

.legend-ind-title {
    font-weight: 600;
    font-size: 11px;
}

.legend-ind-val {
    font-family: monospace;
    color: var(--text);
    font-size: 10.5px;
}

.legend-ind-actions {
    display: flex;
    align-items: center;
    gap: 4px;
    opacity: 0;
    transition: opacity 150ms var(--ease);
    margin-left: 4px;
}

.legend-ind-row:hover .legend-ind-actions {
    opacity: 1;
}

.legend-ind-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 10px;
    padding: 1px 2px;
    border-radius: 3px;
    color: var(--muted);
    transition: color 120ms var(--ease), background-color 120ms var(--ease), transform 100ms var(--ease);
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.legend-ind-btn:hover {
    color: var(--text);
    background-color: hsla(220, 20%, 40%, 0.4);
    transform: scale(1.15);
}

body.light-theme .legend-ind-btn:hover {
    background-color: rgba(0, 0, 0, 0.1);
}

.legend-ind-btn:active {
    transform: scale(0.9);
}

/* ── Legend Indicator Dot ──────────────────────────────────────────────── */
.legend-ind-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
}

/* ── Legend: scale down per grid density ─────────────────────────────── */

/* 1-chart grid */
.layout-1 .chart-legend { gap: 2px; }
.layout-1 .main-ohlc    { font-size: 10px; }
.layout-1 .legend-row   { gap: 5px; }
.layout-1 .legend-symbol-name { font-size: 10px; }
.layout-1 .legend-interval    { font-size: 9px; }
.layout-1 .legend-ohlc-label  { font-size: 8px; }
.layout-1 .legend-ohlc-val    { font-size: 9px; margin-right: 5px; }
.layout-1 .legend-ind-title   { font-size: 9px; }
.layout-1 .legend-ind-val     { font-size: 8.5px; }
.layout-1 .legend-ind-dot     { width: 5px; height: 5px; }
.layout-1 .legend-ind-row     { gap: 4px; padding: 1px 3px; }
.layout-1 .indicators-list    { gap: 1px; }

/* 2-chart grid */
.layout-2 .chart-legend { gap: 2px; }
.layout-2 .main-ohlc    { font-size: 9.5px; }
.layout-2 .legend-row   { gap: 4px; }
.layout-2 .legend-symbol-name { font-size: 9.5px; }
.layout-2 .legend-interval    { font-size: 8.5px; }
.layout-2 .legend-ohlc-label  { font-size: 7.5px; }
.layout-2 .legend-ohlc-val    { font-size: 8.5px; margin-right: 4px; }
.layout-2 .legend-ind-title   { font-size: 8.5px; }
.layout-2 .legend-ind-val     { font-size: 8px; }
.layout-2 .legend-ind-dot     { width: 5px; height: 5px; }
.layout-2 .legend-ind-row     { gap: 4px; padding: 1px 3px; }
.layout-2 .indicators-list    { gap: 1px; }

/* 4-chart grid */
.layout-4 .chart-legend { gap: 1px; }
.layout-4 .main-ohlc    { font-size: 9px; }
.layout-4 .legend-row   { gap: 3px; }
.layout-4 .legend-symbol-name { font-size: 9px; }
.layout-4 .legend-interval    { font-size: 8px; }
.layout-4 .legend-ohlc-label  { font-size: 7px; }
.layout-4 .legend-ohlc-val    { font-size: 8px; margin-right: 3px; }
.layout-4 .legend-ind-title   { font-size: 8px; }
.layout-4 .legend-ind-val     { font-size: 7.5px; }
.layout-4 .legend-ind-dot     { width: 5px; height: 5px; }
.layout-4 .legend-ind-row     { gap: 3px; padding: 1px 2px; }
.layout-4 .indicators-list    { gap: 1px; }

/* 6-chart grid */
.layout-6 .chart-legend { gap: 1px; top: 4px; left: 6px; }
.layout-6 .main-ohlc    { font-size: 8px; }
.layout-6 .legend-row   { gap: 2px; }
.layout-6 .legend-symbol-name { font-size: 8px; }
.layout-6 .legend-interval    { font-size: 7px; margin-right: 2px; }
.layout-6 .legend-ohlc-label  { font-size: 6.5px; }
.layout-6 .legend-ohlc-val    { font-size: 7.5px; margin-right: 2px; }
.layout-6 .legend-ind-title   { font-size: 7.5px; }
.layout-6 .legend-ind-val     { font-size: 7px; }
.layout-6 .legend-ind-dot     { width: 4px; height: 4px; }
.layout-6 .legend-ind-row     { gap: 3px; padding: 0px 2px; }
.layout-6 .indicators-list    { gap: 0px; }

/* 8-chart grid — most compact */
.layout-8 .chart-legend { gap: 0px; top: 3px; left: 5px; }
.layout-8 .main-ohlc    { font-size: 7px; }
.layout-8 .legend-row   { gap: 2px; }
.layout-8 .legend-symbol-name { font-size: 7px; }
.layout-8 .legend-interval    { font-size: 6.5px; margin-right: 2px; }
.layout-8 .legend-ohlc-label  { font-size: 6px; }
.layout-8 .legend-ohlc-val    { font-size: 6.5px; margin-right: 2px; }
.layout-8 .legend-ind-title   { font-size: 6.5px; }
.layout-8 .legend-ind-val     { font-size: 6px; }
.layout-8 .legend-ind-dot     { width: 4px; height: 4px; }
.layout-8 .legend-ind-row     { gap: 2px; padding: 0px 2px; }
.layout-8 .indicators-list    { gap: 0px; }


/* ── Alerts Hub Panel ───────────────────────────────────────────────────── */
.alerts-hub {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
}

.alerts-hub-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px 10px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
}

.alerts-hub-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 6px;
}

.alerts-hub-add-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    transition: background 150ms var(--ease), color 150ms var(--ease);
}

.alerts-hub-add-btn:hover {
    background: var(--accent);
    color: #fff;
}

.alerts-hub-body {
    flex: 1;
    overflow-y: auto;
    padding: 10px 0;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}

.alerts-hub-body::-webkit-scrollbar { width: 4px; }
.alerts-hub-body::-webkit-scrollbar-track { background: transparent; }
.alerts-hub-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

.alert-group {
    margin-bottom: 6px;
}

.alert-group-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
}

.alert-group-count {
    font-size: 10px;
    font-weight: 600;
    padding: 0px 5px;
    border-radius: 8px;
    background: hsla(220, 20%, 35%, 0.5);
    color: var(--muted);
}

.alert-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    transition: background 120ms var(--ease);
}

.alert-item:hover {
    background: hsla(220, 20%, 28%, 0.35);
}

body.light-theme .alert-item:hover {
    background: rgba(0,0,0,0.04);
}

.alert-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
}

.alert-status-active   .alert-status-dot { background: #10b981; box-shadow: 0 0 5px rgba(16,185,129,0.5); }
.alert-status-paused   .alert-status-dot { background: #f59e0b; }
.alert-status-triggered .alert-status-dot { background: var(--muted); }

.alert-item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.alert-item-symbol {
    font-size: 11px;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 5px;
}

.alert-item-symbol-badge {
    font-size: 9px;
    padding: 1px 5px;
    border-radius: 4px;
    background: hsla(220, 20%, 35%, 0.6);
    color: var(--muted);
    font-weight: 600;
}

.alert-item-price {
    font-size: 11.5px;
    font-weight: 600;
    font-family: monospace;
    color: var(--text);
}

.alert-item-distance {
    font-size: 10px;
    color: var(--muted);
    font-family: monospace;
    margin-left: 4px;
}
.alert-item-distance.above { color: #10b981; }
.alert-item-distance.below { color: #ef4444; }

.alert-item-meta {
    font-size: 9.5px;
    color: var(--muted);
}

.alert-item-actions {
    display: flex;
    align-items: center;
    gap: 3px;
    opacity: 0;
    transition: opacity 150ms var(--ease);
    flex-shrink: 0;
}

.alert-item:hover .alert-item-actions {
    opacity: 1;
}

.alert-action-btn {
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 3px 4px;
    border-radius: 4px;
    color: var(--muted);
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 120ms var(--ease), background 120ms var(--ease), transform 100ms var(--ease);
    line-height: 1;
}

.alert-action-btn:hover {
    color: var(--text);
    background: hsla(220, 20%, 40%, 0.4);
    transform: scale(1.15);
}

.alert-action-btn.danger:hover { color: #ef4444; }
.alert-action-btn.accent:hover { color: #10b981; }

body.light-theme .alert-action-btn:hover {
    background: rgba(0,0,0,0.08);
}

.alert-action-btn:active {
    transform: scale(0.9);
}

.alerts-hub-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 180px;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
    padding: 20px;
}

.alerts-hub-empty svg {
    opacity: 0.35;
}

/* ══════════════════════════════════════════════════════
   NEW FEATURES: Header Nav Tabs · Watchlist · Context Menu
   ══════════════════════════════════════════════════════ */

/* ── Brand Logo ─────────────────────────────────────── */
.brand-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px hsla(215,90%,60%,0.3));
}



/* ── Header Icon Buttons (bell, watchlist toggle) ───── */
.header-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 30px;
    height: 30px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 180ms var(--ease), background 180ms var(--ease),
                border-color 180ms var(--ease), transform 120ms var(--ease-out);
    flex-shrink: 0;
}

.header-icon-btn:hover {
    color: var(--text);
    background: hsla(220, 20%, 28%, 0.5);
    border-color: var(--border);
    transform: scale(1.08);
}

.header-icon-btn:active { transform: scale(0.95); }

.header-icon-btn.active {
    color: var(--blue);
    background: hsla(215, 90%, 60%, 0.14);
    border-color: hsla(215, 90%, 60%, 0.3);
}

/* Notification badge */
.notif-badge {
    position: absolute;
    top: 3px;
    right: 3px;
    min-width: 14px;
    height: 14px;
    padding: 0 3px;
    border-radius: 7px;
    background: var(--red);
    color: #fff;
    font-size: 8px;
    font-weight: 700;
    font-family: inherit;
    line-height: 14px;
    text-align: center;
    pointer-events: none;
    box-shadow: 0 0 0 2px var(--panel);
    animation: badgePulse 2s ease-in-out infinite;
}

/* ── Watchlist Panel ────────────────────────────────── */
.watchlist-panel {
    position: fixed;
    top: 48px;
    right: 0;
    width: 230px;
    height: calc(100vh - 48px - 22px);
    background: var(--panel);
    border-left: 1px solid var(--border);
    box-shadow: -4px 0 24px hsla(0,0%,0%,0.45);
    display: flex;
    flex-direction: column;
    z-index: 300;
    transform: translateX(100%);
    transition: transform 280ms var(--ease-out);
    will-change: transform;
    overflow: hidden;
}

.watchlist-panel.open {
    transform: translateX(0);
}

.watchlist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--panel-3);
    flex-shrink: 0;
}

.watchlist-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text);
    text-transform: uppercase;
}

.watchlist-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 150ms var(--ease), background 150ms var(--ease),
                border-color 150ms var(--ease);
}

.watchlist-close-btn:hover {
    color: var(--text);
    background: hsla(220, 20%, 30%, 0.5);
    border-color: var(--border);
}

.watchlist-body {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}

.watchlist-body::-webkit-scrollbar { width: 4px; }
.watchlist-body::-webkit-scrollbar-track { background: transparent; }
.watchlist-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

.watchlist-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 160px;
    color: var(--muted);
